      "production_evidence": "source/mahayana-agent-coordinator/control-port-client.swift; source/shared/rpc/coordinator-port.swift; source/ios-main/coordinator/coordinator-launcher.swift; source/ios-main/coordinator/coordinator-main-port-client.swift",
