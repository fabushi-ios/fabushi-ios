    {
      "desktop_path": "source/node-agent-coordinator/src/client_side_tool_v2_relay.rs",
      "desktop_blob_sha": "a01c69f3eb7aec0e07a8bcc003d251ad9d3d7c33",
      "desktop_responsibility": "Own client-side-tool-v2 wire validation, agent epoch/sequence fencing, protobuf tool-call identity, Call/Result settlement, current-epoch replay, reset, and shutdown clearing before renderer projection.",
      "desktop_owner": "coordinator",
      "desktop_visible_effect": "Renderer receives only valid current-epoch client-side tool Call/Result/reset events in order; stale epochs/sequences, malformed wire payloads, and orphan Results are dropped, while accepted current state can be replayed after renderer attachment.",
      "ios_disposition": "ios-adapted",
      "ios_target_path": "source/mahayana-agent-coordinator/client-side-tool-v2-relay.swift",
      "ios_language": "Swift",
      "ios_platform_delta": "Desktop Host stdio/event delivery is adapted to the iOS in-process Host/Coordinator request boundary. Coordinator still owns fencing/settlement/replay and renderer projection. The mobile Rust Host turn-observation producer is a separate upstream responsibility and is not yet present.",
      "implementation_status": "implemented",
      "production_evidence": "source/mahayana-agent-coordinator/client-side-tool-v2-relay.swift; source/mahayana-agent-coordinator/MahayanaCoordinator.swift; source/mahayana-agent-coordinator/renderer-port-server.swift; source/ios-main/IOSMainRuntime.swift; source/shared/rpc/client-side-tool-v2-transport.swift",
      "test_evidence": "mobile/ios/FabushiTests/ClientSideToolV2RelayParityTests.swift; mobile/ios/FabushiTests/CoordinatorAdapterTests.swift; mobile/ios/FabushiTests/IOSCoordinatorArchitectureTests.swift; exact-HEAD GitHub Actions pending",
      "notes": "Re-read against Desktop PR #20 bbc7b34a5f6dad46e3d4ca88fe21cc4f7932ce09, blob a01c69f3eb7aec0e07a8bcc003d251ad9d3d7c33. Relay identity is agentId+epoch+sequence+protobuf toolCallId; this source does not own requestId/runId. Cancel/turn teardown enters via reset/epoch change and Coordinator shutdown clear. Coordinator ingress/projection is wired in shipping composition, but end-to-end Host production remains blocked because the iOS mobile Rust Host does not yet port Desktop turn-observation client-side-tool-v2 producer; do not promote to verified until that adjacent producer and exact-HEAD CI are proven."
    },
